# Mirror (target) Supabase project — used only by `npm run dev:mirror` / `npm run build:mirror`.
# Copy to `.env.mirror` and fill in the values from the target project's API settings.
# These are publishable (anon) values only — never put service-role keys here.
VITE_MIRROR_SUPABASE_URL="https://<target-ref>.supabase.co"
VITE_MIRROR_SUPABASE_PUBLISHABLE_KEY="<target-anon-or-publishable-key>"
VITE_MIRROR_SUPABASE_PROJECT_ID="<target-ref>"
